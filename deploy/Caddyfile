# VIXE on https://vixe.online.
# The VPS is shared: its Caddy (locali/deploy/compose.yaml) owns ports 80/443
# and imports /srv/sites/*/Caddyfile, with /home/deploy/sites mounted at
# /srv/sites. This file is installed as /home/deploy/sites/vixe/Caddyfile and
# the releases live next to it (see setup-vps.sh). Caddy gets the certificates.

www.vixe.online {
	redir https://vixe.online{uri} permanent
}

vixe.online {
	root * /srv/sites/vixe/current
	encode zstd gzip

	# Files are small and unhashed, and the service worker is network-first,
	# so let the browser revalidate everything against the ETag.
	header {
		Cache-Control "no-cache"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# Dotfiles never ship, but refuse them anyway.
	@dotfiles path */.*
	respond @dotfiles 404

	file_server
}
